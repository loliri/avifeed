[Unit]
Description=avifeed — random AVIF image server
After=network-online.target
Wants=network-online.target
# If sourceDir lives on a mounted volume (e.g. an HDD), uncomment and set its
# absolute path: systemd then refuses to start the service until the mount is
# active, preventing startup from treating an unmounted sourceDir as empty and
# evicting the whole manifest.
# RequiresMountsFor=/mnt/your-images

[Service]
Type=simple
User=jhll1124
WorkingDirectory=/server/avifeed
# Run node directly so systemd's MainPID is the actual server process and
# SIGTERM is delivered to it without any wrapper in between. `pnpm build`
# produces dist/index.js; package.json sets "main": "dist/index.js".
ExecStart=/usr/local/bin/node dist/index.js
Environment=NODE_ENV=production
Environment=RIS_LOG_LEVEL=info
Restart=on-failure
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
